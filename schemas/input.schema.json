{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlcoholRoutePlannerInput",
  "type": "object",
  "required": [
    "city",
    "district",
    "preferred_area",
    "party_size",
    "convenience_store_target"
  ],
  "properties": {
    "city": {
      "type": "string",
      "minLength": 1
    },
    "district": {
      "type": "string",
      "minLength": 1
    },
    "preferred_area": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "party_size": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "distance_km": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0.5
        },
        "max": {
          "type": "number",
          "minimum": 0.5
        }
      }
    },
    "duration_minutes": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 15
        },
        "max": {
          "type": "integer",
          "minimum": 15
        }
      }
    },
    "convenience_store_target": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "start_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "end_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "loop_preference": {
      "type": "string",
      "enum": [
        "loop",
        "one_way",
        "either"
      ],
      "default": "either"
    },
    "nightlife_priority": {
      "type": "boolean",
      "default": true
    },
    "route_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 3
    },
    "map_aspect_ratio": {
      "type": "string",
      "default": "9:16"
    },
    "language": {
      "type": "string",
      "default": "zh-CN"
    }
  },
  "anyOf": [
    {
      "required": [
        "distance_km"
      ]
    },
    {
      "required": [
        "duration_minutes"
      ]
    }
  ],
  "additionalProperties": false
}